# DevCLI 配置示例
# 用法：
# 1. 复制本文件为 .env
# 2. 按需填写下面的配置项
# 3. 未填写的项会回退到代码默认值

# ========== Anthropic Messages 配置（默认 provider） ==========
# 对接 Claude / Anthropic Messages 原生兼容端点；服务端地址不要以斜杠结尾
# ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Anthropic API 版本（可选，默认 2023-06-01）
# ANTHROPIC_VERSION=2023-06-01

# ========== OpenAI 兼容配置 ==========
# 对接 OpenAI 官方或任意 OpenAI Chat Completions 兼容端点（vLLM / Ollama OpenAI 模式 / OneAPI / 代理网关）
# API Key（/model openai 切换后使用）
# OPENAI_API_KEY=your_openai_api_key_here
# 模型名称（可选，默认 gpt-4o）
# OPENAI_MODEL=gpt-4o
# Base URL（可选，默认 https://api.openai.com/v1；兼容端点填自己的网关地址）
# OPENAI_BASE_URL=https://api.openai.com/v1
# 中转站如要求渠道/分组，可按需填写
# OPENAI_CHANNEL=Other
# OPENAI_GROUP=Other

# ========== GLM 配置 ==========
# API Key（/model glm 或 /model glm-5.1 切换后使用）
# GLM_API_KEY=your_glm_api_key_here
# 模型名称（可选，默认 glm-5.1）
# 可选值：glm-5.1, glm-5v-turbo, glm-5.0, glm-4-flash 等
# glm-5v-turbo 支持图片输入，可配合 Ctrl+V / @image: 使用
# GLM_MODEL=glm-5.1

# ========== DeepSeek 配置 ==========
# API Key（/model deepseek 切换后使用）
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 模型名称（可选，默认 deepseek-v4-flash）
# 可选值：deepseek-v4-flash, deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-v4-flash
# Base URL（可选，默认 https://api.deepseek.com/chat/completions；可填网关根地址）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ========== 阶跃星辰 StepFun 配置 ==========
# API Key（/model step 切换后使用）
# STEP_API_KEY=your_step_api_key_here
# 模型名称（可选，默认 step-3.5-flash）
# 可选值：step-3.5-flash, step-3.5-flash-2603, step-router-v1, step-1-256k 等
# STEP_MODEL=step-3.5-flash
# Base URL（可选，默认 https://api.stepfun.com/v1）
# 如果使用 Step Plan 专用通道，可设置为 https://api.stepfun.com/step_plan/v1
# STEP_BASE_URL=https://api.stepfun.com/v1

# ========== Kimi / Moonshot 配置 ==========
# API Key（/model kimi 切换后使用；兼容官方 MOONSHOT_API_KEY）
# KIMI_API_KEY=your_kimi_api_key_here
# MOONSHOT_API_KEY=your_moonshot_api_key_here
# 模型名称（可选，默认 kimi-k2.6；兼容 MOONSHOT_MODEL）
# KIMI_MODEL=kimi-k2.6
# Base URL（可选，默认 https://api.moonshot.ai/v1；兼容 MOONSHOT_BASE_URL）
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# Embedding 配置（用于 /index、/search、Agent 的代码检索）
# 支持 provider：ollama / openai / zhipu / glm
# 不配置时默认使用 ollama + nomic-embed-text:latest + http://localhost:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_BASE_URL=http://localhost:11434

# 如果使用需要鉴权的远程 Embedding 服务，再打开这一项
# EMBEDDING_API_KEY=your_api_key_here

# Rerank 配置（默认开启，用于 RRF 后的 Cross-Encoder 二阶段重排）
# 默认指向本地 Docker 暴露的 OpenAI-compatible /rerank endpoint；不可用时自动降级回 RRF
RERANK_ENABLED=true
# RERANK_PROVIDER=openai
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=http://localhost:8000/v1
# RERANK_API_KEY=your_api_key_here
# RERANK_CANDIDATE_LIMIT=20
# RERANK_MAX_INPUT_CHARS=1200

# ========== Web 搜索配置 ==========
# 选择搜索 provider（zhipu | serpapi | searxng），不配置时按 Key/URL 自动判断：
# 1. 有 GLM_API_KEY → zhipu（默认推荐：与 GLM 推理共用 Key，零额外配置，国内首选）
# 2. 有 SERPAPI_KEY → serpapi（国际通用，付费即开即用）
# 3. 有 SEARXNG_URL → searxng（开源自托管，免费，需本地跑 docker 实例）
# SEARCH_PROVIDER=zhipu

# 智谱 Web Search 引擎（SEARCH_PROVIDER=zhipu 时启用）
# 可选：search_std（0.01 元/次，默认）、search_pro（0.03 元/次）、
#       search_pro_sogou（0.05 元/次，搜狗）、search_pro_quark（0.05 元/次，夸克）
# 中文搜索建议用 search_pro 或搜狗 / 夸克版本，效果优于通用 std
# ZHIPU_SEARCH_ENGINE=search_std

# SerpAPI Key（SEARCH_PROVIDER=serpapi 时启用）
# 免费 100 次/月：https://serpapi.com/manage-api-key
# SERPAPI_KEY=your_serpapi_key_here

# SearXNG 实例地址（SEARCH_PROVIDER=searxng 时启用）
# 本地 docker：docker run --rm -p 8888:8888 searxng/searxng
# 公共实例（不稳定，仅试玩）：见 https://searx.space
# SEARXNG_URL=http://localhost:8888

# ========== Web 抓取配置 ==========
# web_fetch 工具：抓取 URL 并提取正文 Markdown
# 当前实现走「直接 HTTP + Jsoup + 简易 readability」，对静态/SSR 页面有效
# 对 SPA / 防爬墙站点会返回空正文（已知边界），Agent 会 fallback 到 Chrome DevTools MCP
# 默认安全策略：屏蔽 file:// / 内网 / loopback；30 秒超时；5MB 响应上限；每分钟 30 次限流

# ========== MCP 配置 ==========
# MCP server 配置文件位置：
# 1. 用户级 ~/.devcli/mcp.json
# 2. 项目级 .devcli/mcp.json（按 server 名覆盖用户级）
# 支持 ${PROJECT_DIR}、${HOME} 和环境变量 ${VAR} 展开。
# 远程 Streamable HTTP server 常用 token 示例：
# REMOTE_TOKEN=your_remote_mcp_token_here

# ========== 渲染器形态（v16.1+）==========
# 默认 inline 流式 TUI（Claude Code 风格：底部状态栏 + 行内可折叠工具块 + 行内 diff）
# DEVCLI_RENDERER=inline    # 默认值，显式声明
# DEVCLI_RENDERER=lanterna  # 切换到 Lanterna 三栏全屏 TUI（v16 形态，可选保留）
# DEVCLI_RENDERER=plain     # 纯 println 兜底，无折叠/状态栏
# DEVCLI_NO_STATUSBAR=true  # inline 模式下禁用底部状态栏（终端不支持 DECSTBM 时使用）
# 重定向输入默认按 UTF-8 解码；旧式 GBK 控制台可显式覆盖。
# DEVCLI_TERMINAL_ENCODING=GBK
# 终端支持 ANSI 但被探测为 dumb 时，可强制使用 xterm-256color 能力。
# DEVCLI_TERMINAL_FORCE_ANSI=true

# 兼容旧设置：DEVCLI_TUI=true 自动映射为 DEVCLI_RENDERER=lanterna（已 deprecated）
# DEVCLI_TUI=true

# ========== LSP 诊断注入（第 17 期）==========
# write_file 成功后触发 post-edit 诊断；当前 MVP 对 Java 文件使用 JavaParser 语法诊断，
# 不依赖本机安装 JDT LS。后续接真实 LSP server 时复用同一注入链路。
# DEVCLI_LSP_ENABLED=true
# DEVCLI_LSP_MAX_DIAGNOSTICS=20

# ========== Side-Git 快照与回滚（第 18 期）==========
# 每个用户 turn 开始前创建 pre-turn 快照，结束后异步创建 post-turn 快照。
# 快照仓库位于 ~/.devcli/snapshots/<project_hash>/<worktree_hash>/.git，不写用户项目 .git。
# DEVCLI_SNAPSHOT_ENABLED=true
# DEVCLI_SNAPSHOT_MAX=50
# DEVCLI_SNAPSHOT_EXCLUDES=.git,.devcli/snapshots,target,node_modules,dist,.idea,*.class,*.jar
# DEVCLI_SNAPSHOT_DIR=/Users/yourname/.devcli/snapshots
# 裁剪累计达到阈值或超过最小间隔后，回收 Side-Git 不可达的松散对象。
# DEVCLI_SNAPSHOT_GC_ENABLED=true
# DEVCLI_SNAPSHOT_GC_PRUNED_THRESHOLD=100
# DEVCLI_SNAPSHOT_GC_MIN_INTERVAL_HOURS=24
# DEVCLI_SNAPSHOT_GC_MAX_SECONDS=30

# ========== Multi-Agent ==========
# 并行 Worker 数量，范围 1-8，默认 2。
# DEVCLI_TEAM_WORKERS=2
# Planner 输出解析或结构校验失败后的修复次数，范围 0-3，默认 2。
# DEVCLI_TEAM_PLANNER_REPAIR_MAX_ATTEMPTS=2

# ========== 隔离工作区与补丁提交 ==========
# 副作用任务默认在项目下 Temp/devcli-workspaces 隔离执行。
# DEVCLI_WORKSPACE_ISOLATION_ENABLED=true
# 崩溃遗留目录超过该小时数后清理；活动文件租约持有的工作区不会删除。
# DEVCLI_WORKSPACE_ORPHAN_TTL_HOURS=24
# ToolRegistry 共享的资源租约后台清理周期；project fork 不重复创建线程。
# DEVCLI_RESOURCE_LEASE_CLEANUP_INTERVAL_SECONDS=60
# 隔离任务和 Pre-Review 命令强制使用 Docker；镜像必须提前拉取，执行时不联网且禁止自动拉取。
# DEVCLI_COMMAND_SANDBOX_IMAGE=maven:3.9.9-eclipse-temurin-17
# DEVCLI_COMMAND_SANDBOX_DOCKER_BINARY=docker
# 跨进程项目提交锁目录，默认 ~/.devcli/locks/project-commit/。
# DEVCLI_PROJECT_COMMIT_LOCK_DIR=/Users/yourname/.devcli/locks/project-commit
# 默认 300 秒；复制超时会取消工作线程并终止本次隔离任务。
# 后端默认 auto：Git 仓库使用原生 worktree，非 Git 目录使用 copy；可显式指定 git 或 copy。
# DEVCLI_WORKSPACE_BACKEND=auto
# DEVCLI_WORKSPACE_COPY_TIMEOUT_SECONDS=300
# 孤儿 PatchSet 写前日志默认保留 24 小时；存在对应 checkpoint 的日志不会清理。
# DEVCLI_PATCH_JOURNAL_TTL_HOURS=24

# ========== 后台任务 + Runtime API（第 20 期）==========
# 后台任务 SQLite 队列默认位于 ~/.devcli/tasks/tasks.db
# DEVCLI_TASK_DIR=/Users/yourname/.devcli/tasks
# 后台任务 worker 数，默认 2
# DEVCLI_TASK_WORKERS=2

# Runtime API 仅监听 127.0.0.1，并强制要求 API Key。
# 启动示例：
#   DEVCLI_RUNTIME_API_KEY=your_local_api_key java -jar target/devcli-1.0-SNAPSHOT.jar serve --http --port 8080
# 请求头：
#   Authorization: Bearer your_local_api_key
# 或：
#   X-DevCLI-API-Key: your_local_api_key
# DEVCLI_RUNTIME_API_KEY=your_local_api_key
# DEVCLI_RUNTIME_DIR=/Users/yourname/.devcli/runtime

# ========== Chrome DevTools MCP ==========
# ~/.devcli/mcp.json 不存在时，DevCLI 会自动创建默认 chrome-devtools 配置：
# npx -y chrome-devtools-mcp@latest --isolated=true
# isolated 模式使用临时 user-data-dir；复用登录态时，Chrome 144+ 推荐在
# chrome://inspect/#remote-debugging 勾选 Allow remote debugging for this browser instance，
# 然后让 Agent 自动调用 browser_connect，或手动执行 /browser connect。
# 如果希望默认连接调试 Chrome，可手动把 ~/.devcli/mcp.json args 改成：
# ["-y", "chrome-devtools-mcp@latest", "--autoConnect"]
# 旧式 CDP HTTP JSON 端口可改成：
# ["-y", "chrome-devtools-mcp@latest", "--browser-url=http://127.0.0.1:9222"]
# 如果首次启动 npx 拉包或 Chrome 冷启较慢，可调长 MCP initialize 超时：
# DEVCLI_MCP_INITIALIZE_TIMEOUT_SECONDS=60

# ========== LLM HTTP 超时（可选）==========
# SSE 流式接口下，readTimeout 是"两次 read 之间最大间隔"。
# GLM-5.1 在生成大段 reasoning_content 时服务端可能长时间静默，超时容易触发。
# 仅当遇到频繁 "调用 LLM 失败: timeout" 时再调大；通过 -D 系统属性传入：
#   java -Ddevcli.llm.read.timeout.seconds=600 -jar target/devcli-1.0-SNAPSHOT.jar
# 默认值：connect=60s / read=300s / write=60s / call=600s

# ========== LLM 统一重试（可选）==========
# 只重试限流、过载、超时、网络错误和 5xx；认证、参数、上下文超限、内容过滤不重试。
# 流式响应已经输出内容后禁止重试，避免重复展示和重复工具调用。
# DEVCLI_LLM_RETRY_MAX_ATTEMPTS=3
# DEVCLI_LLM_RETRY_INITIAL_DELAY_MS=500
# DEVCLI_LLM_RETRY_MAX_DELAY_MS=8000
# DEVCLI_LLM_RETRY_JITTER_RATIO=0.2

# ========== 长期记忆生命周期（可选）==========
# 新写入记忆默认 TTL：FACT=180 天、FEEDBACK=365 天、SUMMARY=30 天、CONVERSATION/TOOL_RESULT=7 天。
# 设为 0 表示不过期；类型级配置覆盖统一配置。
# DEVCLI_MEMORY_TTL_DAYS=180
# DEVCLI_MEMORY_TTL_FACT_DAYS=180
# DEVCLI_MEMORY_TTL_FEEDBACK_DAYS=365
# DEVCLI_MEMORY_TTL_SUMMARY_DAYS=30

# ========== 只读工具结果缓存（可选）==========
# 仅缓存成功且无图片的 READ_ONLY 工具结果；任何项目或外部变更都会清空缓存。
# DEVCLI_TOOL_RESULT_CACHE_MAX_ENTRIES=128
# DEVCLI_TOOL_RESULT_CACHE_TTL_SECONDS=30

# 日志配置（支持自动滚动、压缩和清理）
# 默认日志目录：~/.devcli/logs
# 默认日志文件：~/.devcli/logs/devcli.log
# 日志级别可选：ERROR / WARN / INFO / DEBUG
DEVCLI_LOG_LEVEL=INFO

# 日志目录。~ 会展开为当前用户主目录
DEVCLI_LOG_DIR=~/.devcli/logs

# 最多保留多少天的历史日志
DEVCLI_LOG_MAX_HISTORY=7

# 单个日志文件滚动前的最大体积
DEVCLI_LOG_MAX_FILE_SIZE=10MB

# 所有归档日志允许占用的总容量，超出后会自动清理更老的日志
DEVCLI_LOG_TOTAL_SIZE_CAP=100MB

# ========== 操作审计配置 ==========
# 危险工具（write_file / execute_command / create_project / revert_turn）调用会按天写一行 JSONL 审计
# 默认目录：~/.devcli/audit/audit-YYYY-MM-DD.jsonl
# 也可通过 -Ddevcli.audit.dir=/path/to/dir 系统属性覆盖
# DEVCLI_AUDIT_DIR=/Users/yourname/.devcli/audit

# ========== 第 15 期：Skill 系统 ==========
# Skill 加载位置（按优先级，后者覆盖前者）：
#   1. jar 内置 (resources/skills/) — DevCLI 自带 web-access
#   2. 用户级 ~/.devcli/skills/<name>/SKILL.md
#   3. 项目级 <project>/.devcli/skills/<name>/SKILL.md
# 启动期 jar 内置 skill 自动解压到 ~/.devcli/skills-cache/<name>/，避免每次启动 IO
# 启用状态持久化：~/.devcli/skills.json （格式 {"disabled": ["name1", ...]}，默认全启用）
# 内置 web-access 含决策手册 + 6 个 site-patterns（mp.weixin / zhihu / x.com / xiaohongshu / github / juejin）
# CLI: /skill list | /skill show <name> | /skill on/off <name> | /skill reload
# LLM 自决加载：当 system prompt 里某个 skill 的 description 匹配任务时，LLM 调 load_skill(name) 加载完整指引
