    <mxCell id="delete_box" value="&lt;b&gt;删除 / 不再新增&lt;/b&gt;&lt;br&gt;Memory.md 作为第二事实源 · TODO.md / Plan.md 作为运行状态源 · 通用 SubAgent 充当 Curator · recurrence 原文自动保存 · 按最近 N 轮硬裁剪 · 过期即物理删除 · 仅按使用次数排序" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1">
      <mxGeometry x="40" y="780" width="1540" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="note" value="核心原则：短期层解决上下文窗口；工作层解决当前任务真相；长期层解决跨任务复用。压缩摘要不晋升，工作状态不复制，长期事实不未经验证写入。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4f8;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
